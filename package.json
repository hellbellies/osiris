{
  "name": "osiris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "install:mac": "tauri build --bundles app && rm -rf /Applications/osiris.app && ditto src-tauri/target/release/bundle/macos/osiris.app /Applications/osiris.app",
    "typecheck": "vue-tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
